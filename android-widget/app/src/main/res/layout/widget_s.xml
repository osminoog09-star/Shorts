<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/bg" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="0dp" android:layout_weight="1" android:layout_height="20dp" android:src="@drawable/wordmark" android:scaleType="fitStart" android:adjustViewBounds="true" android:contentDescription="M1lash"/>
        <TextView android:id="@+id/updated" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#9C9AB0" android:textSize="11sp" android:text="…"/>
        <TextView android:id="@+id/refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  ⟳" android:textColor="#EFEEF6" android:textSize="16sp" android:paddingStart="6dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/subs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#EFEEF6" android:textStyle="bold" android:textSize="24sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="подписчики" android:textColor="#9C9AB0" android:textSize="11sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/week" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#EFEEF6" android:textStyle="bold" android:textSize="24sp"/>
            <TextView android:id="@+id/delta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="просм. 7 дней" android:textColor="#9C9AB0" android:textSize="11sp"/>
        </LinearLayout>
        
    </LinearLayout>
    <ImageView android:id="@+id/chart" android:visibility="gone" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:scaleType="fitXY" android:contentDescription="график"/>
    <TextView android:id="@+id/fresh" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#EFEEF6" android:textSize="12sp" android:maxLines="2" android:ellipsize="end"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp">
        <TextView android:id="@+id/ypp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F0B54A" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
        <ProgressBar android:id="@+id/ypp_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="3dp" android:max="1000" android:progress="0" android:progressTint="#FF5FA8" android:progressBackgroundTint="#3A3850"/>
    </LinearLayout>
    <TextView android:id="@+id/today" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#FFD38A" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/top" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#EFEEF6" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/idea" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#8FD6FF" android:textSize="12sp" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
    <TextView android:id="@+id/review" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#F0B54A" android:textStyle="bold" android:textSize="13sp" android:visibility="gone"/>
    <TextView android:id="@+id/next" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#C9C7D9" android:textSize="12sp" android:maxLines="2" android:text="Загрузка…"/>
</LinearLayout>
