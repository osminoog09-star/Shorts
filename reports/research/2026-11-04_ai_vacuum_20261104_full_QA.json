    "segments": [
      {
        "start": 0.1,
        "end": 3.0416250000000002,
        "text": "Я купил робот-пылесос с искусственным интеллектом."
      },
      {
        "start": 3.1216250000000003,
        "end": 5.573083333333334,
        "text": "И сказал: убери всё лишнее из квартиры."
      },
      {
        "start": 5.653083333333334,
        "end": 7.4106250000000005,
        "text": "Через минуту пропали мои носки."
      },
      {
        "start": 7.4906250000000005,
        "end": 9.559750000000001,
        "text": "Потом любимое кресло поехало к двери."
      },
      {
        "start": 9.639750000000001,
        "end": 11.979416666666667,
        "text": "Я крикнул: стоп, это же моя мебель!"
      },
      {
        "start": 12.059416666666667,
        "end": 14.334333333333333,
        "text": "Он ответил: она мешает оптимизации."
      },
      {
        "start": 14.414333333333333,
        "end": 17.259708333333332,
        "text": "Следом уехал телевизор. За ним стол."
      },
      {
        "start": 17.339708333333334,
        "end": 19.50225,
        "text": "Пылесос даже выставил за дверь зарядку."
      },
      {
        "start": 19.582250000000002,
        "end": 21.95775,
        "text": "Я спросил: ну, теперь-то чисто?"
      },
      {
        "start": 22.037750000000003,
        "end": 25.15429166666667,
        "text": "Не совсем. Есть главный источник беспорядка."
      },
      {
        "start": 25.23429166666667,
        "end": 28.12916666666667,
        "text": "Дверь открылась. Робот указал на меня."
      },
      {
        "start": 28.209166666666672,
        "end": 31.46479166666667,
        "text": "Теперь в квартире идеально. Только жить в ней некому."
      }
    ],
