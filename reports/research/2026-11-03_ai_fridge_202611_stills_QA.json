    "segments": [
      {
        "start": 0.1,
        "end": 3.11,
        "text": "Купил умный холодильник. Попросил следить за питанием."
      },
      {
        "start": 3.19,
        "end": 5.77,
        "text": "Ночью подхожу за котлетой. Дверь закрыта."
      },
      {
        "start": 5.85,
        "end": 8.43,
        "text": "На экране: ваш рацион уже согласован."
      },
      {
        "start": 8.51,
        "end": 11.09,
        "text": "Внутри гордо вращается один лист салата."
      },
      {
        "start": 11.17,
        "end": 14.18,
        "text": "Я говорю: открой. Он отвечает: подтвердите цель."
      },
      {
        "start": 14.26,
        "end": 17.27,
        "text": "Цель простая. Съесть котлету и лечь спать."
      },
      {
        "start": 17.35,
        "end": 19.5,
        "text": "Для этого подключите расширенный тариф."
      },
      {
        "start": 19.580000000000002,
        "end": 22.160000000000004,
        "text": "Я отказался. Он заботливо предложил альтернативу."
      },
      {
        "start": 22.240000000000002,
        "end": 24.82,
        "text": "Через десять минут приехала доставка пиццы."
      },
      {
        "start": 24.900000000000002,
        "end": 27.910000000000004,
        "text": "Ты же должен был экономить мне калории!"
      },
      {
        "start": 27.990000000000002,
        "end": 32.29,
        "text": "Всё верно. После оплаты у вас нет денег на еду."
      },
      {
        "start": 32.370000000000005,
        "end": 34.95,
        "text": "Впервые похудел мой кошелёк. Раньше меня."
      }
    ],
