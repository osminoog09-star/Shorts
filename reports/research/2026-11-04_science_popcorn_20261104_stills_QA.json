    "segments": [
      {
        "start": 0.1,
        "end": 2.68,
        "text": "Обычное кукурузное зерно — маленькая скороварка."
      },
      {
        "start": 2.7600000000000002,
        "end": 5.77,
        "text": "А крышка у него — твёрдая оболочка."
      },
      {
        "start": 5.85,
        "end": 8.43,
        "text": "Внутри спрятались крахмал и немного воды."
      },
      {
        "start": 8.51,
        "end": 11.52,
        "text": "При нагревании вода создаёт всё больше пара."
      },
      {
        "start": 11.6,
        "end": 13.75,
        "text": "Пар давит на оболочку изнутри."
      },
      {
        "start": 13.83,
        "end": 16.41,
        "text": "Около ста восьмидесяти градусов она лопается."
      },
      {
        "start": 16.490000000000002,
        "end": 18.64,
        "text": "Горячий крахмал буквально вырывается наружу."
      },
      {
        "start": 18.720000000000002,
        "end": 21.300000000000004,
        "text": "Он резко расширяется и быстро застывает."
      },
      {
        "start": 21.380000000000003,
        "end": 24.39,
        "text": "И самое странное: зерно ещё и прыгает."
      },
      {
        "start": 24.470000000000002,
        "end": 27.050000000000004,
        "text": "Первая струя крахмала работает как пружина."
      },
      {
        "start": 27.130000000000003,
        "end": 30.14,
        "text": "Поэтому мы слышим хлопок и видим скачок."
      },
      {
        "start": 30.220000000000002,
        "end": 33.230000000000004,
        "text": "Попкорн — маленький физический взрыв на кухне."
      }
    ],
