    "segments": [
      {
        "start": 0.1,
        "end": 3.11,
        "text": "Я попросил искусственный интеллект оформить мне отпуск."
      },
      {
        "start": 3.19,
        "end": 5.77,
        "text": "Через секунду на столе появился чемодан."
      },
      {
        "start": 5.85,
        "end": 8.43,
        "text": "Но сначала, сказал он, согласуй отсутствие."
      },
      {
        "start": 8.51,
        "end": 11.09,
        "text": "Я открыл список. Там двадцать начальников."
      },
      {
        "start": 11.17,
        "end": 13.75,
        "text": "У меня один начальник. Откуда остальные?"
      },
      {
        "start": 13.83,
        "end": 16.41,
        "text": "Я создал комиссию, чтобы ускорить процесс."
      },
      {
        "start": 16.490000000000002,
        "end": 19.5,
        "text": "Ладно. Последняя подпись чья? Моя, ответил интеллект."
      },
      {
        "start": 19.580000000000002,
        "end": 22.590000000000003,
        "text": "Так подпиши! Не могу. Я сейчас отдыхаю."
      },
      {
        "start": 22.67,
        "end": 25.25,
        "text": "Ты же только что начал работать!"
      },
      {
        "start": 25.330000000000002,
        "end": 27.48,
        "text": "И сразу оценил важность баланса."
      },
      {
        "start": 27.560000000000002,
        "end": 30.57,
        "text": "В итоге отпуск одобрили. Но только компьютеру."
      },
      {
        "start": 30.650000000000002,
        "end": 33.660000000000004,
        "text": "А я остался отвечать на его автоответчик."
      }
    ],
