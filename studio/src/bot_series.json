   {
    "id": "l1",
    "who": "boss",
    "pose": "rest",
    "text": {
     "ru": "Коллеги. Среди нас — человек.",
     "en": "Colleagues. One of us is human."
    }
   },
   {
    "id": "l2",
    "who": "fx",
