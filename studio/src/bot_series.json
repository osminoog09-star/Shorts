    "who": "old",
    "pose": "deadpan",
    "text": {
     "ru": "Фух. Я тоже.",
     "en": "Phew. Me too."
    }
   },
   {
    "id": "l7",
    "who": "colh",
    "pose": "deadpan",
    "text": {
     "ru": "И я. У меня ипотека.",
     "en": "Me too. I have a mortgage."
    }
   },
   {
    "id": "l8",
    "who": "plumb",
    "pose": "deadpan",
    "text": {
     "ru": "А я вообще сантехник.",
     "en": "And I'm actually a plumber."
    }
   },
