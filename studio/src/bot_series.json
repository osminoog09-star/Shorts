    "text": {
     "ru": "",
     "en": ""
    }
   },
   {
    "id": "l3",
    "who": "n",
    "pose": "shock",
    "text": {
     "ru": "Всё. Сейчас меня разберут на запчасти.",
     "en": "That's it. They'll strip me for parts."
    }
   },
   {
    "id": "l4",
    "who": "n",
    "pose": "shrug",
    "punch": true,
    "text": {
     "ru": "Ладно! Это я! Я человек! Я ем пельмени!",
     "en": "Fine! It's me! I'm human! I eat dumplings!"
    }
   },
   {
    "id": "l5",
    "who": "fx",
    "sfx": "crickets",
    "dur": 44,
    "pose": "deadpan",
    "text": {
     "ru": "",
     "en": ""
    }
   },
