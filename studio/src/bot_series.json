 {
  "id": "ep2",
  "num": 2,
  "title": {
   "ru": "тест на бота",
   "en": "the bot test"
  },
  "end": {
   "ru": "продолжение следует…",
   "en": "to be continued…"
  },
  "accent": "#3fd6b2",
  "lines": [
   {
    "id": "l1",
    "who": "n",
    "pose": "talk",
    "text": {
     "ru": "Коробка на голову. Голос — как у навигатора.",
     "en": "Box on my head. Voice like a GPS."
    }
   },
   {
    "id": "l2",
    "who": "nr",
    "pose": "rest",
    "text": {
     "ru": "ЗДРАВСТВУЙТЕ. Я. НЕЙРОСЕТЬ. ВАСЯ-ДВА.",
     "en": "HELLO. I AM. NEURAL NETWORK. KEVIN-TWO."
    }
   },
   {
    "id": "l3",
    "who": "hr",
    "pose": "rest",
    "text": {
     "ru": "Капча. Докажите, что вы не человек. Восемьсот сорок семь на триста девяносто два.",
     "en": "Captcha. Prove you are not human. Eight forty-seven times three ninety-two."
    }
   },
   {
    "id": "l4",
    "who": "nw",
    "pose": "shock",
    "text": {
     "ru": "Калькулятор… калькулятор, [бип], быстрее!",
     "en": "Calculator… calculator, [beep], faster!"
    }
   },
   {
    "id": "l5",
    "who": "nr",
    "pose": "rest",
    "text": {
     "ru": "ТРИСТА ТРИДЦАТЬ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ЧЕТЫРЕ.",
     "en": "THREE HUNDRED THIRTY-TWO THOUSAND TWENTY-FOUR."
    }
   },
   {
    "id": "l6",
    "who": "hr",
    "pose": "rest",
    "text": {
     "ru": "Принят. Добро пожаловать в семью.",
     "en": "Hired. Welcome to the family."
    }
   },
   {
    "id": "l7",
    "who": "col",
    "pose": "rest",
    "text": {
     "ru": "Почему у тебя кофе?",
     "en": "Why do you have coffee?"
    }
   },
   {
    "id": "l8",
    "who": "n",
    "pose": "talk",
    "text": {
     "ru": "Это… охлаждающая жидкость. Для процессора.",
     "en": "It's… coolant. For my processor."
    }
   },
   {
    "id": "l9",
    "who": "col",
    "pose": "rest",
    "text": {
     "ru": "Можно глоток?",
     "en": "Can I have a sip?"
    }
   },
   {
    "id": "l10",
    "who": "n",
    "pose": "deadpan",
    "punch": true,
    "text": {
     "ru": "…Нет.",
     "en": "…No."
    }
