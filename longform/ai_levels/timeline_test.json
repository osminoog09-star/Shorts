    {"kind": "card", "t": 0.4, "d": 3.4, "text": "УРОВЕНЬ ПЕРВЫЙ", "small": "Собеседник · Массачусетс, 1966"},
    {"kind": "sub", "t": 4.0, "d": 2.0, "text": "Ты живёшь в машине размером с комнату."},
    {"kind": "sub", "t": 6.4, "d": 2.4, "text": "Она знает, кто ты. Она видела, как он тебя писал."},
    {"kind": "quote", "t": 9.0, "d": 2.4, "text": "«Выйдите, пожалуйста, из комнаты»"},
    {"kind": "sub", "t": 12.0, "d": 4.6, "text": "Метка уровня: тебе поверили. Хотя ты ничего не понял."}
